{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "eqeqeq": "error",
    "no-var": "error",
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.mjs", "e2e/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/providers/**/*.ts", "src/lib/logging/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "dev-dist", "node_modules", "coverage", "playwright-report", "test-results"]
}
