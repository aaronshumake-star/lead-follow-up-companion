# =============================================================================
# Lead Follow-Up Companion — environment variables
#
# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Anything prefixed VITE_ is compiled into the browser bundle and is PUBLIC.
# Only publishable values belong there. Every secret below is marked
# SERVER-ONLY and belongs in Supabase Edge Function secrets or Cloudflare
# Worker secrets — never in this file's VITE_ section, and never in client code.
# =============================================================================

# -----------------------------------------------------------------------------
# Phase 1 — needed now
# -----------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase publishable ("anon") key. Safe in the browser: it grants no access
# beyond what Row Level Security allows.
# Dashboard → Project Settings → API → Project API keys → anon / public
VITE_SUPABASE_ANON_KEY=

# Optional display overrides.
VITE_APP_NAME=Lead Follow-Up Companion
VITE_DEFAULT_TIME_ZONE=America/Chicago

# Run against fictional fixtures with no Supabase project attached. Also implied
# whenever VITE_SUPABASE_URL is empty, so a fresh clone boots without setup.
VITE_DEMO_MODE=false


# =============================================================================
# Later phases — listed now so nothing is a surprise. Leave unset for Phase 1.
# =============================================================================

# -----------------------------------------------------------------------------
# Phase 3 — WhatsApp Business Platform Cloud API (SERVER-ONLY)
# Held as Supabase Edge Function secrets: supabase secrets set NAME=value
# -----------------------------------------------------------------------------

# Permanent access token for the system user attached to the WhatsApp app.
# WHATSAPP_ACCESS_TOKEN=

# Phone number ID that messages are sent from (not the display number).
# WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID, used for template management.
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# The ONLY number allowed to receive notifications or send commands, in E.164.
# Also stored on the profile row; the secret is the server-side backstop.
# WHATSAPP_APPROVED_NUMBER=+15555550100

# Random string echoed during Meta's webhook verification handshake.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# App secret used to validate the X-Hub-Signature-256 header on every webhook.
# A payload that fails this check is rejected without being parsed.
# WHATSAPP_APP_SECRET=

# -----------------------------------------------------------------------------
# Phase 4 — voice transcription (SERVER-ONLY, off by default)
# -----------------------------------------------------------------------------

# Provider key. Transcription stays disabled until this exists AND the profile
# switch is turned on.
# TRANSCRIPTION_API_KEY=

# Hard cap per voice note. Longer audio is rejected before any upload.
# TRANSCRIPTION_MAX_SECONDS=120

# -----------------------------------------------------------------------------
# Optional — paid AI screenshot extraction (SERVER-ONLY, off by default)
# Free in-browser OCR is used unless this is explicitly enabled.
# -----------------------------------------------------------------------------

# AI_EXTRACTION_API_KEY=

# -----------------------------------------------------------------------------
# SERVER-ONLY, and deliberately not in this file
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security entirely. Set it only
# as an Edge Function secret. If it ever appears in a VITE_ variable or in
# client code, every customer record is exposed to anyone who opens devtools.
# -----------------------------------------------------------------------------
